# TeriChat local environment — copy to `.env` and adjust. Never commit `.env`.
# Every variable: purpose, default, required?, secret?, environments.

# HTTP port for terichat-server. Default 3001 (avoids SPICE backend on 3000).
# Required: no. Secret: no. Environments: local/dev.
PORT=3001

# Structured log filter (tracing EnvFilter syntax).
# Required: no. Secret: no. Environments: all.
RUST_LOG=info

# PostgreSQL connection string for the next slice (migrations/auth).
# Baseline boots WITHOUT it (/ready reports "not_configured").
# Required: no (baseline) / yes (once migrations land). Secret: local-only password. Environments: local/CI/staging/prod (each own value).
DATABASE_URL=postgres://terichat:terichat_dev_pw@127.0.0.1:5432/terichat
