{
  "name": "terichat-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "TeriChat Alpha 0 desktop client (Tauri + React + TS + Tailwind + Vite)",
  "scripts": {
    "dev": "vite --port 1420 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:acceptance:unit": "node --test acceptance/report.test.mjs",
    "validate:acceptance": "node acceptance/report.mjs",
    "validate:restart": "node acceptance/verify-restart.mjs",
    "test:acceptance": "node acceptance/run.mjs",
    "test:acceptance:native": "node acceptance/run.mjs --native",
    "test:acceptance:restart": "node acceptance/restart-exe.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/instrument-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/plugin-http": "^2.6.0",
    "@tauri-apps/plugin-notification": "^2.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.20",
    "jsdom": "^30.0.1",
    "playwright-core": "1.63.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "~5.6.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
