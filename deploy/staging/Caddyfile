# TeriChat staging edge: same-origin API proxy + static web UI.
# Two ways in: tailnet IP (WireGuard-encrypted, plain HTTP) and the public
# chat.unknownchat.xyz via the SPICE edge Caddy (edge terminates TLS, this
# stays plain HTTP on :80 in-container).
# NOTE: the box's :80 belongs to the SPICE edge Caddy, so compose publishes
# this on host :8080 — but the site stays portless (:80 in-container) so the
# host port remains a publish detail and :443 migration stays trivial.
# Upstream errors log the request through the default logger, outside the
# site's access-log filter below; strip attachment filenames there too.
{
    log default {
        output stderr
        format filter {
            wrap json
            request>headers>X-Filename delete
        }
    }
}

http://{$STAGING_HOST}, http://chat.unknownchat.xyz {
    # API + gateway WebSocket (upgrade handled automatically).
    # Health/readiness must preserve API status, never SPA's misleading 200.
    handle /health {
        reverse_proxy api:3001
    }
    handle /ready {
        reverse_proxy api:3001
    }
    handle /v1/* {
        reverse_proxy api:3001
    }

    # Static React bundle with SPA fallback.
    handle {
        root * /srv/www
        try_files {path} /index.html
        file_server
    }

    log {
        output stdout
        # Attachment filenames are user content: drop the upload header and
        # the download disposition from access logs (percent encoding is
        # reversible, and Caddy only redacts credential headers by default).
        format filter {
            wrap json
            request>headers>X-Filename delete
            resp_headers>Content-Disposition delete
        }
    }
}
