# TeriChat staging edge: same-origin API proxy + static web UI.
# Tailnet-only mode (no public domain yet): plain HTTP on :80 — the tailnet
# itself is WireGuard-encrypted, so no ACME needed. When a public hostname
# lands, change the site address to {$STAGING_HOST} and Caddy provisions TLS.
http://{$STAGING_HOST} {
    # API + gateway WebSocket (upgrade handled automatically).
    # /health is explicit so edge checks never fall through to the SPA.
    handle /health {
        reverse_proxy api:3001
    }
    handle /v1/* {
        reverse_proxy api:3001
    }

    # Static React bundle with SPA fallback.
    handle {
        root * /srv/www
        try_files {path} /index.html
        file_server
    }

    log {
        output stdout
    }
}
