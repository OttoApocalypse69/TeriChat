# Staging secrets — copy to `.env` (untracked, never commit) and fill in.
# Generate the password with: openssl rand -base64 32

# Public hostname served by Caddy (TLS via ACME). Example: chat.example.com
STAGING_HOST=

# Postgres role password (used by both db and api services).
POSTGRES_PASSWORD=

# API database URL (internal service name, no public exposure).
DATABASE_URL=postgres://terichat:${POSTGRES_PASSWORD}@db:5432/terichat

# Optional server tuning.
RUST_LOG=info
